{
  "name": "omp-agent-chatroom",
  "version": "0.1.0",
  "description": "In-process multi-agent chatroom: claim board, bounded chat, blocking waits",
  "type": "module",
  "scripts": {
    "test": "bun test tests/",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "lint": "bunx --bun @biomejs/biome check src tests",
    "lint:fix": "bunx --bun @biomejs/biome check src tests --write"
  },
  "omp": {
    "name": "Agent Chatroom",
    "version": "0.1.0",
    "description": "In-process multi-agent chatroom: claim board, bounded chat, blocking waits",
    "extensions": ["./src/index.ts"],
    "features": {
      "room": {
        "description": "Room store, claim board, and the room tool",
        "default": true,
        "extensions": ["./src/index.ts"]
      },
      "wait-tools": {
        "description": "Blocking wait tool (wait_for_claim)",
        "default": true,
        "extensions": ["./src/index.ts"]
      }
    }
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.7.0"
  },
  "files": ["src", "skills", "README.md"],
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
